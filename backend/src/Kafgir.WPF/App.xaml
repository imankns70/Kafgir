<Application x:Class="Kafgir.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Kafgir.WPF.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Kafgir/KafgirTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:OrderStatusToForegroundConverter x:Key="OrderStatusForegroundConverter" />
            <converters:OrderStatusToBackgroundConverter x:Key="OrderStatusBackgroundConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
