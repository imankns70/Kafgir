<UserControl x:Class="Kafgir.WPF.Views.OrderReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Kafgir.WPF.Controls"
             xmlns:converters="clr-namespace:Kafgir.WPF.Converters"
             FlowDirection="RightToLeft">
    <UserControl.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
    </UserControl.InputBindings>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:OrderStatusToPersianConverter x:Key="OrderStatusConverter" />
        <converters:DeliveryMethodToPersianConverter x:Key="DeliveryMethodConverter" />
        <converters:PaymentMethodToPersianConverter x:Key="PaymentMethodConverter" />
        <Style x:Key="ReportFilterTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="ReportFilterComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="ReportDetailText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style x:Key="ReportDetailLabel" TargetType="TextBlock" BasedOn="{StaticResource FormLabel}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="ReportGridText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid Visibility="{Binding IsDetailPageVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,10" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right">
                        <TextBlock Text="گزارش کل" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="گزارش سفارش‌های روزانه با فیلترهای ترکیبی" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResultSummary}"
                               DockPanel.Dock="Left"
                               Foreground="{StaticResource BrandBrush}"
                               FontSize="16"
                               FontWeight="Medium"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundSecondaryBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMedium}"
                    Padding="12"
                    Margin="0,0,0,10">
                <WrapPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="تاریخ" Style="{StaticResource FormLabel}" />
                        <controls:PersianDatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="وضعیت" Style="{StaticResource FormLabel}" />
                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding SelectedStatusFilter}" DisplayMemberPath="DisplayName" Width="165" Style="{StaticResource ReportFilterComboBox}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="نوع دریافت" Style="{StaticResource FormLabel}" />
                        <ComboBox ItemsSource="{Binding DeliveryMethods}" SelectedItem="{Binding SelectedDeliveryMethod}" DisplayMemberPath="DisplayName" Width="165" Style="{StaticResource ReportFilterComboBox}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="نوع فروش" Style="{StaticResource FormLabel}" />
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}" DisplayMemberPath="DisplayName" Width="165" Style="{StaticResource ReportFilterComboBox}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="شماره سفارش" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding OrderNumberSearch, UpdateSourceTrigger=PropertyChanged}" Width="130" Style="{StaticResource ReportFilterTextBox}" FlowDirection="LeftToRight" TextAlignment="Right" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="نام مشتری" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding CustomerNameSearch, UpdateSourceTrigger=PropertyChanged}" Width="155" Style="{StaticResource ReportFilterTextBox}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="شماره تماس" Style="{StaticResource FormLabel}" />
                        <TextBox Text="{Binding PhoneNumberSearch, UpdateSourceTrigger=PropertyChanged}" Width="145" Style="{StaticResource ReportFilterTextBox}" FlowDirection="LeftToRight" TextAlignment="Right" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,8">
                        <TextBlock Text="غذا" Style="{StaticResource FormLabel}" />
                        <ComboBox ItemsSource="{Binding Foods}" SelectedItem="{Binding SelectedFood}" DisplayMemberPath="DisplayName" Width="180" Style="{StaticResource ReportFilterComboBox}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,10,8">
                        <Button Content="جستجو" Command="{Binding SearchCommand}" MinWidth="86" />
                        <Button Content="پاک کردن" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButton}" MinWidth="88" />
                    </StackPanel>
                </WrapPanel>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource SurfaceCard}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SuccessMessage}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" />
                        <TextBlock Text="در حال دریافت گزارش..."
                                   Foreground="{StaticResource BrandBrush}"
                                   FontWeight="Medium"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding OrdersPagination.Items}"
                              SelectedItem="{Binding SelectedOrder, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره سفارش" Binding="{Binding OrderNumber}" Width="120" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTextColumn Header="نام مشتری" Binding="{Binding CustomerFullName}" Width="*" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTextColumn Header="شماره تماس" Binding="{Binding CustomerPhoneNumber}" Width="130" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTemplateColumn Header="وضعیت" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadge}" Background="{Binding Status, Converter={StaticResource OrderStatusBackgroundConverter}}" BorderBrush="{Binding Status, Converter={StaticResource OrderStatusForegroundConverter}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource OrderStatusConverter}}" Foreground="{Binding Status, Converter={StaticResource OrderStatusForegroundConverter}}" Style="{StaticResource StatusText}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="نوع دریافت" Binding="{Binding DeliveryMethod, Converter={StaticResource DeliveryMethodConverter}}" Width="115" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTextColumn Header="نوع فروش" Binding="{Binding PaymentMethod, Converter={StaticResource PaymentMethodConverter}}" Width="120" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTextColumn Header="غذاها" Binding="{Binding FoodSummary}" Width="2*" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTextColumn Header="تعداد" Binding="{Binding TotalQuantity}" Width="70" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTextColumn Header="مبلغ" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="115" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTextColumn Header="زمان" Binding="{Binding CreatedAt, StringFormat={}{0:HH:mm yyyy/MM/dd}}" Width="160" ElementStyle="{StaticResource ReportGridText}" />
                            <DataGridTemplateColumn Header="جزئیات" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="نمایش"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="8,3"
                                                MinHeight="32"
                                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <controls:PaginationControl Grid.Row="2" DataContext="{Binding OrdersPagination}" />
                </Grid>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsDetailPageVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource SurfaceCard}" Margin="0,0,0,10" Padding="14">
                <DockPanel>
                    <Button Content="بازگشت به گزارش"
                            DockPanel.Dock="Left"
                            Command="{Binding BackToReportCommand}"
                            Style="{StaticResource SecondaryButton}"
                            MinWidth="130" />
                    <StackPanel DockPanel.Dock="Right">
                        <TextBlock Text="جزئیات سفارش" Style="{StaticResource PageTitle}" />
                        <TextBlock Text="{Binding Details.Order.OrderNumber, StringFormat=شماره سفارش: {0}}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource SurfaceCard}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Details.Order}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="اطلاعات مشتری" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                    <TextBlock Text="نام مشتری" Style="{StaticResource ReportDetailLabel}" />
                                    <TextBlock Text="{Binding CustomerFullName}" Style="{StaticResource ReportDetailText}" />
                                    <TextBlock Text="شماره تماس" Style="{StaticResource ReportDetailLabel}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding CustomerPhoneNumber}" Style="{StaticResource ReportDetailText}" />
                                    <TextBlock Text="آدرس" Style="{StaticResource ReportDetailLabel}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding AddressLine}" Style="{StaticResource ReportDetailText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="اطلاعات سفارش" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                    <TextBlock Text="وضعیت" Style="{StaticResource ReportDetailLabel}" />
                                    <Border Style="{StaticResource StatusBadge}" HorizontalAlignment="Right"
                                            Background="{Binding Status, Converter={StaticResource OrderStatusBackgroundConverter}}"
                                            BorderBrush="{Binding Status, Converter={StaticResource OrderStatusForegroundConverter}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource OrderStatusConverter}}"
                                                   Foreground="{Binding Status, Converter={StaticResource OrderStatusForegroundConverter}}"
                                                   Style="{StaticResource StatusText}" />
                                    </Border>
                                    <TextBlock Text="روش دریافت" Style="{StaticResource ReportDetailLabel}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding DeliveryMethod, Converter={StaticResource DeliveryMethodConverter}}" Style="{StaticResource ReportDetailText}" />
                                    <TextBlock Text="روش فروش" Style="{StaticResource ReportDetailLabel}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding PaymentMethod, Converter={StaticResource PaymentMethodConverter}}" Style="{StaticResource ReportDetailText}" />
                                    <TextBlock Text="مبلغ کل" Style="{StaticResource ReportDetailLabel}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}}" Style="{StaticResource ReportDetailText}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="یادداشت‌ها" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                                    <TextBlock Text="یادداشت مشتری" Style="{StaticResource ReportDetailLabel}" />
                                    <TextBlock Text="{Binding CustomerNote}" Style="{StaticResource ReportDetailText}" TextWrapping="Wrap" />
                                    <TextBlock Text="یادداشت ادمین" Style="{StaticResource ReportDetailLabel}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding AdminNote}" Style="{StaticResource ReportDetailText}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="اقلام سفارش" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                        <DataGrid ItemsSource="{Binding Items}" Height="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="غذا" Binding="{Binding FoodName}" Width="*" ElementStyle="{StaticResource ReportGridText}" />
                                <DataGridTextColumn Header="تعداد" Binding="{Binding Quantity}" Width="90" ElementStyle="{StaticResource ReportGridText}" />
                                <DataGridTextColumn Header="قیمت واحد" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="130" ElementStyle="{StaticResource ReportGridText}" />
                                <DataGridTextColumn Header="جمع" Binding="{Binding TotalPrice, StringFormat={}{0:N0}}" Width="130" ElementStyle="{StaticResource ReportGridText}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Text="تاریخچه وضعیت" Style="{StaticResource SectionTitle}" Margin="0,16,0,8" />
                        <DataGrid ItemsSource="{Binding StatusHistories}" Height="190">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="از" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusBadge}" Background="{Binding FromStatus, Converter={StaticResource OrderStatusBackgroundConverter}}" BorderBrush="{Binding FromStatus, Converter={StaticResource OrderStatusForegroundConverter}}"><TextBlock Text="{Binding FromStatus, Converter={StaticResource OrderStatusConverter}}" Foreground="{Binding FromStatus, Converter={StaticResource OrderStatusForegroundConverter}}" Style="{StaticResource StatusText}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="به" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusBadge}" Background="{Binding ToStatus, Converter={StaticResource OrderStatusBackgroundConverter}}" BorderBrush="{Binding ToStatus, Converter={StaticResource OrderStatusForegroundConverter}}"><TextBlock Text="{Binding ToStatus, Converter={StaticResource OrderStatusConverter}}" Foreground="{Binding ToStatus, Converter={StaticResource OrderStatusForegroundConverter}}" Style="{StaticResource StatusText}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTextColumn Header="زمان" Binding="{Binding ChangedAt, StringFormat={}{0:HH:mm yyyy/MM/dd}}" Width="180" ElementStyle="{StaticResource ReportGridText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
