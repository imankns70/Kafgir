<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Double x:Key="Space4">4</sys:Double>
    <sys:Double x:Key="Space8">8</sys:Double>
    <sys:Double x:Key="Space12">12</sys:Double>
    <sys:Double x:Key="Space16">16</sys:Double>
    <sys:Double x:Key="Space20">20</sys:Double>
    <sys:Double x:Key="Space24">24</sys:Double>
    <sys:Double x:Key="Space32">32</sys:Double>
    <sys:Double x:Key="Space40">40</sys:Double>
    <sys:Double x:Key="Space48">48</sys:Double>
    <sys:Double x:Key="Space64">64</sys:Double>

    <sys:Double x:Key="IconXs">14</sys:Double>
    <sys:Double x:Key="IconSm">16</sys:Double>
    <sys:Double x:Key="IconMd">20</sys:Double>
    <sys:Double x:Key="IconLg">24</sys:Double>
    <sys:Double x:Key="IconXl">32</sys:Double>
    <sys:Double x:Key="BrandSymbolSm">32</sys:Double>
    <sys:Double x:Key="BrandSymbolMd">48</sys:Double>
    <sys:Double x:Key="BrandSymbolLg">72</sys:Double>

    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
    <CornerRadius x:Key="RadiusLarge">16</CornerRadius>
    <CornerRadius x:Key="RadiusExtraLarge">20</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="10" Direction="270" Opacity="0.08" ShadowDepth="2" Color="#5D3D2A" />
    <DropShadowEffect x:Key="FloatingShadow" BlurRadius="24" Direction="270" Opacity="0.12" ShadowDepth="7" Color="#5D3D2A" />
    <DropShadowEffect x:Key="DialogShadow" BlurRadius="42" Direction="270" Opacity="0.18" ShadowDepth="14" Color="#5D3D2A" />
    <DropShadowEffect x:Key="NavigationShadow" BlurRadius="16" Direction="90" Opacity="0.09" ShadowDepth="3" Color="#5D3D2A" />
</ResourceDictionary>
