<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BrandTerracottaColor">#E46A4A</Color>
    <Color x:Key="BrandOliveColor">#6F7F4E</Color>
    <Color x:Key="BrandSaffronColor">#F2B233</Color>

    <Color x:Key="BrandPrimaryColor">#C44D31</Color>
    <Color x:Key="BrandPrimaryHoverColor">#B9472D</Color>
    <Color x:Key="BrandPrimaryPressedColor">#A53D26</Color>
    <Color x:Key="BrandPrimarySoftColor">#FBE1D8</Color>
    <Color x:Key="BrandSecondaryColor">#617044</Color>
    <Color x:Key="BrandSecondaryHoverColor">#53613B</Color>
    <Color x:Key="BrandSecondaryPressedColor">#465431</Color>
    <Color x:Key="BrandSecondarySoftColor">#E5EADB</Color>
    <Color x:Key="BrandAccentColor">#F2B233</Color>
    <Color x:Key="BrandAccentSoftColor">#FFF0C8</Color>

    <Color x:Key="BackgroundColor">#FFF3E2</Color>
    <Color x:Key="BackgroundSecondaryColor">#F8E9D3</Color>
    <Color x:Key="SurfaceColor">#FFFAF3</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <Color x:Key="SurfaceMutedColor">#EADCC0</Color>
    <Color x:Key="BorderColor">#E5D5BB</Color>
    <Color x:Key="BorderStrongColor">#CBB997</Color>
    <Color x:Key="TextPrimaryColor">#2B2B2B</Color>
    <Color x:Key="TextSecondaryColor">#626057</Color>
    <Color x:Key="TextMutedColor">#716D63</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFDF9</Color>
    <Color x:Key="TextOnSecondaryColor">#FFFDF9</Color>

    <Color x:Key="SuccessColor">#4F6F3A</Color>
    <Color x:Key="SuccessSoftColor">#E5EBD9</Color>
    <Color x:Key="WarningColor">#8B5E00</Color>
    <Color x:Key="WarningSoftColor">#FFF0C8</Color>
    <Color x:Key="ErrorColor">#B33A32</Color>
    <Color x:Key="ErrorSoftColor">#FBE2DE</Color>
    <Color x:Key="InfoColor">#496A70</Color>
    <Color x:Key="InfoSoftColor">#E2EEF0</Color>
    <Color x:Key="DisabledColor">#B9B0A2</Color>
    <Color x:Key="FocusColor">#A7432E</Color>
    <Color x:Key="OverlayColor">#942B2B2B</Color>
    <Color x:Key="WarmShadowColor">#5D3D2A</Color>

    <SolidColorBrush x:Key="BrandTerracottaBrush" Color="{StaticResource BrandTerracottaColor}" />
    <SolidColorBrush x:Key="BrandOliveBrush" Color="{StaticResource BrandOliveColor}" />
    <SolidColorBrush x:Key="BrandSaffronBrush" Color="{StaticResource BrandSaffronColor}" />
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandPrimaryHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />
    <SolidColorBrush x:Key="BrandPrimaryPressedBrush" Color="{StaticResource BrandPrimaryPressedColor}" />
    <SolidColorBrush x:Key="BrandPrimarySoftBrush" Color="{StaticResource BrandPrimarySoftColor}" />
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}" />
    <SolidColorBrush x:Key="BrandSecondaryHoverBrush" Color="{StaticResource BrandSecondaryHoverColor}" />
    <SolidColorBrush x:Key="BrandSecondaryPressedBrush" Color="{StaticResource BrandSecondaryPressedColor}" />
    <SolidColorBrush x:Key="BrandSecondarySoftBrush" Color="{StaticResource BrandSecondarySoftColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandAccentSoftBrush" Color="{StaticResource BrandAccentSoftColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="BackgroundSecondaryBrush" Color="{StaticResource BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="{StaticResource SurfaceMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}" />
    <SolidColorBrush x:Key="TextOnSecondaryBrush" Color="{StaticResource TextOnSecondaryColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />
    <SolidColorBrush x:Key="DisabledBrush" Color="{StaticResource DisabledColor}" />
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}" />
    <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource OverlayColor}" />

    <!-- Compatibility aliases retained while views move to semantic names. -->
    <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource BackgroundSecondaryColor}" />
    <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandPrimaryColor}" />
    <SolidColorBrush x:Key="BrandHoverBrush" Color="{StaticResource BrandPrimaryHoverColor}" />
    <SolidColorBrush x:Key="BrandDarkBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="BrandSoftBrush" Color="{StaticResource BrandPrimarySoftColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="SageBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource BrandSecondaryPressedColor}" />
    <SolidColorBrush x:Key="SidebarHoverBrush" Color="{StaticResource BrandSecondaryHoverColor}" />
    <SolidColorBrush x:Key="SidebarMutedBrush" Color="{StaticResource BrandSecondarySoftColor}" />
</ResourceDictionary>
