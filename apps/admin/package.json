{
  "name": "@kafgir/admin",
  "version": "1.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --win nsis --x64",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kafgir/contracts": "1.0.0",
    "@kafgir/server-core": "1.0.0",
    "cloudinary": "^2.10.0",
    "drizzle-orm": "0.45.2",
    "jalaali-js": "^2.0.0",
    "pino": "^10.3.1",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/jalaali-js": "^1.2.0",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "ir.kafgir.admin",
    "productName": "Kafgir Admin",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "extraResources": [
      {
        "from": "build/kafgir.ico",
        "to": "kafgir.ico"
      }
    ],
    "win": {
      "icon": "build/kafgir.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "کفگیر"
    }
  }
}
