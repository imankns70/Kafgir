DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kafgir
FOOD_UPLOAD_ROOT=
LOG_ROOT=
LOG_LEVEL=info
LOG_MAX_FILE_BYTES=5242880
JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
JWT_ISSUER=Kafgir
JWT_AUDIENCE=Kafgir.Admin
JWT_EXPIRES_MINUTES=720
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_REQUIRE_INIT_DATA=true
TELEGRAM_INIT_DATA_MAX_AGE_MINUTES=1440
SMS_PROVIDER=smsir
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_CODE_PARAMETER=Code
CUSTOMER_OTP_SECRET=replace-with-at-least-32-random-characters
CUSTOMER_ALLOWED_ORIGINS=
# Number of proxies between the internet and this process. Required in production — leaving it unset
# there is a hard configuration error, not a default. It MUST be counted from the real chain before
# rollout, not assumed. Send a request to the deployed app and
# read the `X-Forwarded-For` it receives — the hop count is how many entries the infrastructure
# appended (a CDN in front of the load balancer makes it 2, not 1).
# Too high discards a valid chain and collapses everyone into one bucket; too low reads an entry the
# caller supplied and lets them choose their own rate-limit bucket. The value below is an unverified
# placeholder. Use 0 when Next.js is reached directly, which ignores forwarded headers entirely.
TRUSTED_PROXY_HOPS=1
NOTIFICATION_PROCESSOR_SECRET=replace-with-a-random-secret
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_INITIAL_RETRY_SECONDS=60
